# Web3Forms — service d'envoi des demandes de devis vers contact@poelesgodin.fr
# 1) Crée un compte gratuit sur https://web3forms.com (juste un email à fournir)
# 2) Copie la "access key" qu'on te donne
# 3) Crée un fichier .env.local et colle la valeur dedans
# 4) Sur Vercel : ajoute la variable PUBLIC_WEB3FORMS_KEY dans Settings → Environment Variables

PUBLIC_WEB3FORMS_KEY=YOUR_KEY_HERE

# Site URL (configuré dans astro.config.mjs, ici pour référence)
PUBLIC_SITE_URL=https://www.poelesgodin.fr
