---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import BandeauConfiance from "../components/BandeauConfiance.astro";
import PuissanceCalculator from "../components/PuissanceCalculator.astro";
import ComparatifBoisGranules from "../components/ComparatifBoisGranules.astro";
import LaGamme from "../components/LaGamme.astro";
import AidesEstimator from "../components/AidesEstimator.astro";
import GalerieTemoignages from "../components/GalerieTemoignages.astro";
import Faq from "../components/Faq.astro";
import CTA from "../components/CTA.astro";

const faqEssentielles = [
  {
    q: "Combien de temps entre le devis et l'allumage du poêle ?",
    a: "Comptez 4 à 8 semaines en moyenne entre la signature du devis et la mise en service, selon la disponibilité du modèle et les éventuels travaux de fumisterie. Notre visite technique gratuite est calée sous 8 jours après votre demande.",
  },
  {
    q: "Quelles aides je peux obtenir en 2026 ?",
    a: "MaPrimeRénov' 2026 + CEE = jusqu'à 2 400 € d'aides cumulables sur un poêle à granulés (foyer modeste, hors Île-de-France). Utilisez l'estimateur ci-dessus pour avoir votre montant indicatif. Si vous nous confiez le chantier, nous montons le dossier complet à votre place.",
  },
  {
    q: "Vous intervenez dans quel rayon autour d'Évreux ?",
    a: "Nous intervenons dans l'Eure (27), la Seine-Maritime (76), l'Eure-et-Loir (28), l'Orne (61) et les Yvelines (78). Si vous êtes proche d'une limite, appelez-nous au 02 32 39 59 00 pour confirmer la couverture.",
  },
  {
    q: "Quelle garantie sur le poêle et l'installation ?",
    a: "Garantie constructeur Godin sur les pièces (2 à 5 ans selon modèle). Notre équipe assure le SAV de l'installation à vie — c'est le bénéfice du modèle « un seul interlocuteur » : la personne qui a posé votre poêle reste joignable des années plus tard.",
  },
];
---

<BaseLayout
  title="Poêles Godin à Évreux — Poêles à bois et à granulés en Normandie depuis 1986"
  description="Revendeur officiel Godin depuis 1986. Vente et installation de poêles à bois et à granulés dans l'Eure. Rendement jusqu'à 92 %, devis 48 h, MaPrimeRénov' 2026 incluse."
>
  <Hero />
  <BandeauConfiance />
  <PuissanceCalculator />
  <ComparatifBoisGranules />
  <LaGamme />
  <AidesEstimator />
  <GalerieTemoignages />
  <Faq questions={faqEssentielles} variant="warm" />
  <CTA
    heading="Parlons de votre projet de poêle."
    description="Visitez notre showroom à Normanville ou demandez un devis chiffré en 48 h — aides MaPrimeRénov' incluses."
    ctaLabel="Demander mon devis"
    ctaHref="/contact"
  />
</BaseLayout>
