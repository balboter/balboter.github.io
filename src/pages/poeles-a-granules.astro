---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import AidesEstimator from "../components/AidesEstimator.astro";
import Faq from "../components/Faq.astro";

const modeles = [
  {
    nom: "Godin Cassine",
    puissance: "8 kW",
    surface: "70-100 m²",
    rendement: "90 %",
    autonomie: "30 h",
    ideal: "Pavillon récent bien isolé, chauffage principal",
    image: "/images/installations/164.webp",
    desc: "Programmation hebdomadaire et allumage automatique. Idéal en chauffage principal d'un appartement ou pavillon récent.",
  },
  {
    nom: "Godin Cherville",
    puissance: "10 kW",
    surface: "90-130 m²",
    rendement: "91 %",
    autonomie: "40 h",
    ideal: "Grand pavillon, pilotage à distance pour partir l'esprit léger",
    image: "/images/installations/165.webp",
    desc: "Réservoir grande capacité et pilotage Wi-Fi par application. Confort maximal pour grands volumes.",
    best: true,
  },
  {
    nom: "Godin Iroko",
    puissance: "12 kW",
    surface: "110-160 m²",
    rendement: "92 %",
    autonomie: "48 h",
    ideal: "Maison individuelle 4-5 pièces très bien isolée",
    image: "/images/installations/150.webp",
    desc: "Très haut rendement et silence de fonctionnement renforcé. Pour maisons individuelles bien isolées.",
  },
];

const realisations = [
  { src: "/images/installations/130.webp", lieu: "Séjour · Verneuil-sur-Avre" },
  { src: "/images/installations/177.webp", lieu: "Pavillon moderne · Évreux" },
  { src: "/images/installations/126.webp", lieu: "Pièce à vivre · Pont-Audemer" },
  { src: "/images/installations/201.webp", lieu: "Maison familiale · Eure" },
];

const faqGranules = [
  {
    q: "Un poêle à granulés est-il bruyant ?",
    a: "Modérément. La ventilation forcée et la chute des granulés émettent un bruit de l'ordre de 30 à 45 dB selon le modèle (équivalent d'un réfrigérateur moderne). Les modèles récents Godin sont silencieux en mode économie. Pour une chambre adjacente, on recommande la fonction « silence nocturne » qui coupe le ventilateur.",
  },
  {
    q: "Que se passe-t-il en cas de coupure de courant ?",
    a: "Le poêle s'arrête en sécurité (extinction automatique). À la remise en route du courant, il redémarre selon le programme en cours. Pour des coupures fréquentes, on peut équiper le poêle d'un onduleur (~150-200 €) qui assure une autonomie de 30 min à 2 h selon la capacité.",
  },
  {
    q: "Combien je vais consommer de granulés par hiver ?",
    a: "Comptez 1 à 2 tonnes de granulés par hiver pour une maison de 100 m² bien isolée chauffée principalement aux granulés. À 450-550 € la tonne, soit 500-1 100 € de combustible par an — souvent 2 à 3 fois moins cher que le gaz ou l'électricité au m² chauffé.",
  },
  {
    q: "Comment stocker les granulés ?",
    a: "Au sec et à l'abri de l'humidité. Sacs de 15 kg empilés dans le garage, la cave ou un local technique (compter 1,5 m³ par tonne). Pour les gros consommateurs, livraison en silo extérieur ou en vrac (camion souffleur) — nous conseillons les fournisseurs locaux d'Évreux qui livrent en 48 h.",
  },
  {
    q: "Les granulés perdent-ils de leur qualité ?",
    a: "Stockés au sec, les granulés se conservent plusieurs années sans perte de pouvoir calorifique. Le risque principal est l'humidité (gonflement, perte de calories, dégradation du brûleur). Vérifiez la norme NF Biocombustibles Solides à l'achat — c'est le gage de qualité que nous recommandons.",
  },
];
---

<BaseLayout
  title="Poêles à granulés Godin — Évreux & Normandie"
  description="Poêles à granulés Godin : rendement jusqu'à 92 %, autonomie 30 à 48 h, programmation hebdomadaire. Vente, installation et SAV par nos équipes en Normandie."
>
  <section class="bg-gradient-to-br from-ink-900 via-ink-800 to-ink-900 text-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Nos gammes
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight">
        Poêles à granulés Godin
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-ink-300 max-w-3xl leading-relaxed">
        Le confort de l'automatisme, l'efficacité du granulé bois. Programmation,
        autonomie longue, rendement élevé : les poêles à granulés Godin sont la
        solution moderne pour un chauffage principal performant et économique.
      </p>
      <dl class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 max-w-2xl">
        <div>
          <dt class="text-xs text-ink-400 uppercase tracking-wider">Coût d'usage moyen</dt>
          <dd class="mt-1 text-2xl sm:text-3xl font-bold text-brand-400">~1 €/jour</dd>
          <p class="text-xs text-ink-500 mt-1">en chauffage seul</p>
        </div>
        <div class="sm:pl-8 sm:border-l sm:border-white/15">
          <dt class="text-xs text-ink-400 uppercase tracking-wider">Rendement</dt>
          <dd class="mt-1 text-2xl sm:text-3xl font-bold text-brand-400">90 %+</dd>
          <p class="text-xs text-ink-500 mt-1">2-3× moins cher que gaz</p>
        </div>
        <div class="sm:pl-8 sm:border-l sm:border-white/15">
          <dt class="text-xs text-ink-400 uppercase tracking-wider">Autonomie</dt>
          <dd class="mt-1 text-2xl sm:text-3xl font-bold text-brand-400">48 h</dd>
          <p class="text-xs text-ink-500 mt-1">week-end serein</p>
        </div>
      </dl>
      <p class="mt-8 text-sm text-ink-400">
        Vous hésitez entre bois et granulés ?{" "}
        <a href="/guide-choix" class="text-brand-400 hover:text-brand-300 underline-offset-4 hover:underline font-semibold">
          Voir le guide de choix →
        </a>
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Pourquoi les granulés
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
          Le feu du bois, <span class="text-brand-500">en mode automatique</span>
        </h2>
      </div>
      <div class="mt-8 sm:mt-10 grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
        <article class="p-6 rounded-2xl bg-steel-50 border border-steel-100">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-brand-500 text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-bold text-ink-900">Jusqu'à 48 h d'autonomie</h3>
          <p class="mt-2 text-sm text-ink-600 leading-relaxed">On remplit le réservoir, on programme, l'appareil gère seul l'allumage et la modulation. Un week-end entier sans y toucher.</p>
        </article>
        <article class="p-6 rounded-2xl bg-steel-50 border border-steel-100">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-brand-500 text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-bold text-ink-900">Jusqu'à 92 % de rendement</h3>
          <p class="mt-2 text-sm text-ink-600 leading-relaxed">Les granulés brûlent presque sans perte. C'est le mode de chauffage au feu le plus efficace, 2 à 3 fois moins cher que le gaz au m² chauffé.</p>
        </article>
        <article class="p-6 rounded-2xl bg-steel-50 border border-steel-100">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-brand-500 text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-bold text-ink-900">L'aide MaPrimeRénov' maximale</h3>
          <p class="mt-2 text-sm text-ink-600 leading-relaxed">Le poêle à granulés ouvre droit au barème d'aides le plus élevé : jusqu'à 2 400 € cumulables MaPrimeRénov' + CEE.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-warm-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          La gamme granulés Godin
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
          Trois modèles, de 8 à 12 kW
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {modeles.map((m) => (
          <article class="group rounded-2xl overflow-hidden bg-white border border-ink-100 hover:border-brand-300 hover:shadow-xl transition">
            <div class="aspect-[4/3] overflow-hidden bg-warm-50 relative">
              <img
                src={m.image}
                alt={`${m.nom} ${m.puissance}`}
                width="600"
                height="450"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
              />
              {m.best && (
                <span class="absolute top-3 left-3 inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-brand-500 text-white text-xs font-bold uppercase tracking-wider shadow-md">
                  ⭐ Aide max
                </span>
              )}
            </div>
            <div class="p-6">
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-xl font-bold text-ink-900">{m.nom}</h3>
                <span class="px-2.5 py-1 text-xs font-semibold text-brand-500 bg-brand-50 rounded">
                  {m.puissance}
                </span>
              </div>
              <p class="mt-3 text-ink-600 leading-relaxed text-sm">{m.desc}</p>

              <div class="mt-4 pt-4 border-t border-warm-100">
                <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Idéal pour</p>
                <p class="mt-1 text-sm text-ink-700 font-medium">{m.ideal}</p>
              </div>

              <dl class="mt-4 pt-4 border-t border-warm-100 grid grid-cols-3 gap-2 text-xs">
                <div>
                  <dt class="text-ink-500">Surface</dt>
                  <dd class="font-semibold text-ink-900">{m.surface}</dd>
                </div>
                <div>
                  <dt class="text-ink-500 inline-flex items-center gap-0.5">Rendement <span class="text-brand-500" aria-hidden="true">⭐</span></dt>
                  <dd class="font-semibold text-brand-500">{m.rendement}</dd>
                </div>
                <div>
                  <dt class="text-ink-500">Autonomie</dt>
                  <dd class="font-semibold text-ink-900">{m.autonomie}</dd>
                </div>
              </dl>

              <a
                href={`/contact?modele=${encodeURIComponent(m.nom)}&type=poele-granules`}
                class="mt-5 inline-flex items-center text-sm font-semibold text-brand-500 hover:text-brand-600 transition"
              >
                Demander un devis sur ce modèle →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <AidesEstimator />

  <section class="py-16 sm:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Nos réalisations
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
          Des poêles à granulés Godin installés en Normandie
        </h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {realisations.map((r) => (
          <a href="/galerie" class="group relative aspect-square overflow-hidden rounded-xl bg-warm-50 shadow-md hover:shadow-xl transition">
            <img
              src={r.src}
              alt={`Installation de poêle à granulés Godin — ${r.lieu}`}
              width="500"
              height="500"
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            />
            <span class="absolute bottom-3 left-3 right-3 px-3 py-1.5 rounded-full bg-white/90 backdrop-blur text-xs font-medium text-ink-900 opacity-0 group-hover:opacity-100 transition">{r.lieu}</span>
          </a>
        ))}
      </div>
      <div class="mt-8">
        <a href="/galerie" class="inline-flex items-center gap-2 px-6 py-3 rounded-md bg-steel-50 text-ink-900 font-semibold border border-steel-200 hover:border-brand-400 hover:text-brand-500 transition">
          Voir toute la galerie
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Faq
    eyebrow="Questions fréquentes — Granulés"
    heading="Ce qu'on nous demande avant de passer aux granulés"
    questions={faqGranules}
    variant="warm"
  />

  <CTA
    heading="Bénéficiez de MaPrimeRénov' 2026"
    description="Jusqu'à 2 400 € d'aides cumulables (MaPrimeRénov' + CEE) sur l'installation d'un poêle à granulés. Nous nous occupons du dossier."
  />
</BaseLayout>
