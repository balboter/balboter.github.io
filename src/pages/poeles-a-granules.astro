---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import AidesEstimator from "../components/AidesEstimator.astro";

const modeles = [
  {
    nom: "Godin Amiel",
    puissance: "8 kW",
    surface: "70-100 m²",
    rendement: "90%",
    autonomie: "30 h",
    image: "/images/installations/164.webp",
    desc: "Programmation hebdomadaire, allumage automatique. Idéal en chauffage principal d'un appartement ou pavillon récent.",
  },
  {
    nom: "Godin Soldano",
    puissance: "10 kW",
    surface: "90-130 m²",
    rendement: "91%",
    autonomie: "40 h",
    image: "/images/installations/165.webp",
    desc: "Réservoir grande capacité, télécommande Wi-Fi. Confort maximal pour grands volumes.",
  },
  {
    nom: "Godin Reggio",
    puissance: "12 kW",
    surface: "110-160 m²",
    rendement: "92%",
    autonomie: "48 h",
    image: "/images/installations/166.webp",
    desc: "Très haut rendement, silence de fonctionnement. Pour maisons individuelles bien isolées.",
  },
];
---

<BaseLayout
  title="Poêles à granulés Godin — Évreux & Normandie"
  description="Poêles à granulés Godin : rendement jusqu'à 92 %, autonomie 30 à 48 h, programmation hebdomadaire. Vente, installation et SAV par nos équipes en Normandie."
>
  <section class="bg-gradient-to-br from-ink-900 via-ink-800 to-ink-900 text-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider">
        Nos gammes
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight">
        Poêles à granulés Godin
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-ink-300 max-w-3xl leading-relaxed">
        Le confort de l'automatisme, l'efficacité du granulé bois. Programmation,
        autonomie longue, rendement élevé : les poêles à granulés Godin sont la
        solution moderne pour un chauffage principal performant et économique.
      </p>
      <div class="mt-8 grid grid-cols-3 gap-4 max-w-lg">
        <div>
          <p class="text-3xl font-bold text-brand-400">7,5 ct</p>
          <p class="text-xs text-ink-400 mt-1">€/kWh granulés</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-brand-400">90 %+</p>
          <p class="text-xs text-ink-400 mt-1">de rendement</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-brand-400">48 h</p>
          <p class="text-xs text-ink-400 mt-1">d'autonomie max</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {modeles.map((m) => (
          <article class="group rounded-2xl overflow-hidden bg-white border border-ink-100 hover:border-brand-300 hover:shadow-xl transition">
            <div class="aspect-[4/3] overflow-hidden bg-warm-50">
              <img
                src={m.image}
                alt={`${m.nom} ${m.puissance}`}
                width="600"
                height="450"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
              />
            </div>
            <div class="p-6">
              <div class="flex items-start justify-between gap-2">
                <h2 class="text-xl font-bold text-ink-900">{m.nom}</h2>
                <span class="px-2.5 py-1 text-xs font-semibold text-brand-700 bg-brand-50 rounded">
                  {m.puissance}
                </span>
              </div>
              <p class="mt-3 text-ink-600 leading-relaxed">{m.desc}</p>
              <dl class="mt-5 pt-4 border-t border-ink-100 grid grid-cols-3 gap-2 text-xs">
                <div>
                  <dt class="text-ink-500">Surface</dt>
                  <dd class="font-semibold text-ink-900">{m.surface}</dd>
                </div>
                <div>
                  <dt class="text-ink-500">Rendement</dt>
                  <dd class="font-semibold text-ink-900">{m.rendement}</dd>
                </div>
                <div>
                  <dt class="text-ink-500">Autonomie</dt>
                  <dd class="font-semibold text-ink-900">{m.autonomie}</dd>
                </div>
              </dl>
              <a
                href="/contact"
                class="mt-5 inline-flex items-center text-sm font-semibold text-brand-600 hover:text-brand-700 transition"
              >
                Demander un devis sur ce modèle →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <AidesEstimator />

  <CTA
    heading="Bénéficiez de MaPrimeRénov' 2026"
    description="Jusqu'à 2 400 € d'aides cumulables (MaPrimeRénov' + CEE) sur l'installation d'un poêle à granulés. Nous nous occupons du dossier."
  />
</BaseLayout>
