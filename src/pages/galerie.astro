---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";

const allInstallations = [
  { src: "/images/installations/123.webp", cat: "bois", modele: "Godin Colombe", lieu: "Évreux", lien: "/poeles-a-bois" },
  { src: "/images/installations/124.webp", cat: "cuisiniere", modele: "Godin Souveraine", lieu: "Cuisine de pavillon · Eure", lien: "/cuisinieres" },
  { src: "/images/installations/126.webp", cat: "granules", modele: "Poêle à granulés Godin", lieu: "Pont-Audemer", lien: "/poeles-a-granules" },
  { src: "/images/installations/129.webp", cat: "bois", modele: "Godin Le Petit Godin", lieu: "Petite pièce à vivre", lien: "/poeles-a-bois" },
  { src: "/images/installations/130.webp", cat: "granules", modele: "Godin Cherville", lieu: "Maison contemporaine", lien: "/poeles-a-granules" },
  { src: "/images/installations/145.webp", cat: "bois", modele: "Godin Grand Carvin", lieu: "Longère normande", lien: "/poeles-a-bois" },
  { src: "/images/installations/147.webp", cat: "bois", modele: "Godin Théo", lieu: "Intérieur design", lien: "/poeles-a-bois" },
  { src: "/images/installations/150.webp", cat: "granules", modele: "Godin Iroko", lieu: "Séjour 80 m²", lien: "/poeles-a-granules" },
  { src: "/images/installations/155.webp", cat: "cuisiniere", modele: "Godin Châtelaine", lieu: "Grande cuisine ouverte", lien: "/cuisinieres" },
  { src: "/images/installations/164.webp", cat: "granules", modele: "Godin Cassine", lieu: "Pavillon récent", lien: "/poeles-a-granules" },
  { src: "/images/installations/165.webp", cat: "granules", modele: "Godin Cherville", lieu: "Grand pavillon", lien: "/poeles-a-granules" },
  { src: "/images/installations/168.webp", cat: "bois", modele: "Godin Régate", lieu: "Séjour traversant", lien: "/poeles-a-bois" },
  { src: "/images/installations/169.webp", cat: "bois", modele: "Poêle à bois Godin", lieu: "Maison rénovée", lien: "/poeles-a-bois" },
  { src: "/images/installations/177.webp", cat: "bois", modele: "Godin Carvin", lieu: "Pavillon moderne", lien: "/poeles-a-bois" },
  { src: "/images/installations/200.webp", cat: "bois", modele: "Poêle à bois Godin", lieu: "Véranda chauffée", lien: "/poeles-a-bois" },
  { src: "/images/installations/201.webp", cat: "cuisiniere", modele: "Godin Le Petit Godin Cuisinière", lieu: "Maison familiale", lien: "/cuisinieres" },
  { src: "/images/installations/gallery14-60.webp", cat: "bois", modele: "Poêle à bois Godin", lieu: "Pièce à vivre · Eure", lien: "/poeles-a-bois" },
  { src: "/images/installations/gallery14-116.webp", cat: "granules", modele: "Poêle à granulés Godin", lieu: "Maison normande", lien: "/poeles-a-granules" },
  { src: "/images/installations/gallery78-107.webp", cat: "bois", modele: "Poêle à bois Godin", lieu: "Salon contemporain", lien: "/poeles-a-bois" },
];
---

<BaseLayout
  title="Galerie de nos installations de poêles en Normandie"
  description="Découvrez des installations de poêles à bois, à granulés et de cuisinières Godin réalisées par nos équipes dans l'Eure et en Normandie."
>
  <section class="bg-gradient-to-br from-ink-900 via-ink-800 to-ink-900 text-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Nos réalisations
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight">
        Nos installations de poêles
      </h1>
      <p class="mt-4 text-lg text-ink-300 max-w-3xl">
        Poêles à bois, à granulés et cuisinières Godin posés par nos équipes en Eure, Seine-Maritime et alentours. Cliquez sur une image pour voir la gamme du modèle utilisé.
      </p>
    </div>
  </section>

  <section class="py-10 sm:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap gap-3 mb-8" role="group" aria-label="Filtres par type de produit">
        <button type="button" data-filter="all" class="filter-btn px-4 py-2 rounded-full bg-brand-500 text-white text-sm font-semibold transition" aria-pressed="true">
          Tout (19)
        </button>
        <button type="button" data-filter="bois" class="filter-btn px-4 py-2 rounded-full bg-steel-100 text-ink-700 text-sm font-semibold hover:bg-steel-200 transition" aria-pressed="false">
          Poêles à bois
        </button>
        <button type="button" data-filter="granules" class="filter-btn px-4 py-2 rounded-full bg-steel-100 text-ink-700 text-sm font-semibold hover:bg-steel-200 transition" aria-pressed="false">
          Poêles à granulés
        </button>
        <button type="button" data-filter="cuisiniere" class="filter-btn px-4 py-2 rounded-full bg-steel-100 text-ink-700 text-sm font-semibold hover:bg-steel-200 transition" aria-pressed="false">
          Cuisinières
        </button>
      </div>

      <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          allInstallations.map((p, i) => (
            <a
              href={p.lien}
              class="gallery-item group block overflow-hidden rounded-xl bg-white border border-ink-100 hover:border-brand-300 hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
              data-cat={p.cat}
              data-index={i}
            >
              <div class="relative aspect-[4/3] overflow-hidden bg-warm-50">
                <img
                  src={p.src}
                  alt={`${p.modele} — ${p.lieu}`}
                  width="600"
                  height="450"
                  loading={i < 6 ? "eager" : "lazy"}
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ink-900/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition"></div>
                <div class="absolute bottom-3 left-3 right-3 opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-all duration-300">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/95 backdrop-blur text-xs font-semibold text-ink-900 shadow-md">
                    Voir la gamme →
                  </span>
                </div>
              </div>
              <div class="p-4">
                <p class="font-semibold text-ink-900 text-sm">{p.modele}</p>
                <p class="mt-1 text-xs text-ink-500 inline-flex items-center gap-1">
                  <svg class="w-3 h-3 text-brand-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M10 2C7 2 5 5 5 8c0 3 1 5 5 10 4-5 5-7 5-10 0-3-2-6-5-6zm0 8a2 2 0 110-4 2 2 0 010 4z"/>
                  </svg>
                  {p.lieu}
                </p>
              </div>
            </a>
          ))
        }
      </div>

      <div id="gallery-load-more" class="mt-10 text-center hidden">
        <button
          type="button"
          id="load-more-btn"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-md bg-brand-500 text-white font-semibold hover:bg-brand-600 transition shadow-md"
        >
          Voir 12 réalisations de plus
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <CTA
    heading="Envie d'une installation comme celles-ci ?"
    description="Nous nous déplaçons gratuitement pour étudier votre projet. Devis personnalisé sous 48 h."
  />
</BaseLayout>

<script>
  const PAGE_SIZE = 12;
  const items = Array.from(document.querySelectorAll<HTMLElement>(".gallery-item"));
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const loadMoreWrap = document.getElementById("gallery-load-more");
  const loadMoreBtn = document.getElementById("load-more-btn");
  let currentFilter = "all";
  let visibleCount = PAGE_SIZE;

  function applyDisplay() {
    const matches = items.filter(
      (item) => currentFilter === "all" || item.dataset.cat === currentFilter,
    );
    let shown = 0;
    items.forEach((item) => {
      const matched = currentFilter === "all" || item.dataset.cat === currentFilter;
      if (matched && shown < visibleCount) {
        item.style.display = "";
        shown++;
      } else {
        item.style.display = "none";
      }
    });
    if (loadMoreWrap) {
      loadMoreWrap.classList.toggle("hidden", matches.length <= visibleCount);
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      currentFilter = btn.dataset.filter ?? "all";
      visibleCount = PAGE_SIZE;
      buttons.forEach((b) => {
        b.setAttribute("aria-pressed", "false");
        b.classList.remove("bg-brand-500", "text-white");
        b.classList.add("bg-steel-100", "text-ink-700");
      });
      btn.setAttribute("aria-pressed", "true");
      btn.classList.remove("bg-steel-100", "text-ink-700");
      btn.classList.add("bg-brand-500", "text-white");
      applyDisplay();
    });
  });

  loadMoreBtn?.addEventListener("click", () => {
    visibleCount += PAGE_SIZE;
    applyDisplay();
  });

  applyDisplay();
</script>
