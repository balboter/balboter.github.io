---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import Faq from "../components/Faq.astro";

const realisations = [
  { image: "/images/installations/126.webp", desc: "Cheminée moderne avec habillage pierre, séjour contemporain" },
  { image: "/images/installations/128.webp", desc: "Insert intégré dans cheminée existante, rénovation maison ancienne" },
  { image: "/images/installations/137.webp", desc: "Foyer fermé bois grande vitre panoramique" },
  { image: "/images/installations/148.webp", desc: "Insert à granulés dans habillage sur mesure" },
  { image: "/images/installations/167.webp", desc: "Cheminée traditionnelle revisitée, pierre de taille" },
  { image: "/images/installations/183.webp", desc: "Insert design dans loft réhabilité" },
];

const comparaisonInserts = [
  {
    type: "Insert bois",
    accent: false,
    points: [
      "Rendement : 75-80 %",
      "Coût combustible : le plus bas",
      "Autonomie : 4 à 8 h selon foyer",
      "Entretien : ramonage annuel + cendres",
      "Idéal : amateurs du feu visible, stockage bois OK",
    ],
  },
  {
    type: "Insert granulés",
    accent: true,
    points: [
      "Rendement : 88-92 %",
      "Coût combustible : compétitif",
      "Autonomie : 24 à 48 h programmable",
      "Entretien : ramonage + nettoyage brûleur",
      "Idéal : confort automatique, peu de manipulations",
    ],
  },
];

const decisionPoeleInsert = [
  {
    titre: "Plutôt insert si...",
    items: [
      "Vous avez déjà une cheminée maçonnée à valoriser",
      "Vous voulez garder le caractère ancien de la pièce",
      "Vous n'avez pas d'espace au sol disponible ailleurs",
      "Vous cherchez une intégration discrète",
    ],
  },
  {
    titre: "Plutôt poêle si...",
    items: [
      "Vous partez de zéro (pas de cheminée existante)",
      "Vous voulez un appareil indépendant et déplaçable",
      "Vous cherchez la puissance maximale (poêles 10-13 kW)",
      "L'esthétique fonte traditionnelle vous parle",
    ],
  },
];

const faqInserts = [
  {
    q: "Faut-il tuber le conduit de cheminée ?",
    a: "Quasi systématiquement, oui. Un tubage inox neuf assure étanchéité, sécurité et performance — il est exigé par la norme actuelle pour la plupart des inserts. Compté dans le devis lors de la visite technique. Pour les cheminées récentes (post-2010), le tubage est parfois déjà aux normes.",
  },
  {
    q: "Combien de temps dure l'installation ?",
    a: "2 à 5 jours selon la complexité : 2 jours pour un insert seul, 3-4 jours si tubage + reprise de l'habillage, 5+ jours si reconception complète de l'habillage en pierre/plâtre. Notre équipe planifie le chantier pour minimiser la gêne dans votre logement.",
  },
  {
    q: "Peut-on garder l'habillage actuel de la cheminée ?",
    a: "Souvent oui — la pierre, la brique ou le marbre existant sont préservés si en bon état. Nous adaptons le foyer fermé aux dimensions internes. Si l'habillage est dégradé ou non conforme, nous proposons une rénovation partielle ou totale en accord avec votre esthétique.",
  },
  {
    q: "Insert bois ou insert granulés : la différence concrète ?",
    a: "Insert bois = chaleur authentique, geste manuel, foyer visible avec vraies flammes — idéal en chauffage d'agrément ou complément. Insert granulés = automatisme, programmation, démarrage à froid simple — idéal en chauffage principal pour les ménages qui ne veulent pas s'occuper du feu au quotidien.",
  },
  {
    q: "Mon vieux foyer ouvert n'est pas performant, je peux le transformer ?",
    a: "Oui, c'est même très courant — un foyer ouvert a un rendement de 10-15 % (gaspillage énorme), contre 75-92 % pour un insert fermé. La conversion est le projet le plus rentable que nous réalisons, avec un retour sur investissement de 3 à 5 ans en économies de combustible.",
  },
];
---

<BaseLayout
  title="Cheminées & inserts Godin — Évreux & Normandie"
  description="Cheminées et inserts Godin : foyers fermés, habillages sur mesure, intégration dans cheminée existante. Conception, fabrication et pose par nos équipes en Normandie."
>
  <section class="bg-gradient-to-br from-ink-900 via-ink-800 to-ink-900 text-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Nos gammes
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight">
        Cheminées & inserts
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-ink-300 max-w-3xl leading-relaxed">
        Transformez une cheminée ancienne avec un insert performant, ou créez un
        foyer sur mesure pour votre projet de construction. Nos artisans
        conçoivent et installent l'habillage adapté à votre intérieur.
      </p>
      <p class="mt-6 text-sm text-ink-400">
        Vous préférez un appareil indépendant ?{" "}
        <a href="/poeles-a-bois" class="text-brand-400 hover:text-brand-300 underline-offset-4 hover:underline font-semibold">
          Voir nos poêles à bois →
        </a>
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-warm-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Insert bois ou insert granulés ?
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
          Les deux options, leurs <span class="text-brand-500">vrais usages</span>
        </h2>
        <p class="mt-4 text-base sm:text-lg text-ink-600">
          Même esthétique de cheminée — deux philosophies opposées côté usage et entretien.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {comparaisonInserts.map((c) => (
          <article class={`relative p-6 sm:p-8 rounded-2xl bg-white border-2 ${c.accent ? "border-brand-300 shadow-lg shadow-brand-500/10" : "border-ink-100"} hover:border-brand-400 transition-all hover:-translate-y-1`}>
            {c.accent && (
              <div class="absolute -top-3 left-6 inline-flex items-center gap-1 px-3 py-1 rounded-full bg-brand-500 text-white text-xs font-bold uppercase tracking-wider shadow-md">
                ⭐ Aide max
              </div>
            )}
            <h3 class="text-xl font-bold text-ink-900">{c.type}</h3>
            <ul class="mt-5 space-y-3">
              {c.points.map((p) => (
                <li class="flex items-start gap-3 text-sm text-ink-700">
                  <svg class="flex-shrink-0 w-4 h-4 mt-0.5 text-brand-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mb-16">
        <div class="p-8 bg-warm-50 rounded-2xl border border-warm-100">
          <p class="text-2xl font-bold text-brand-500">1</p>
          <h2 class="mt-2 text-xl font-bold text-ink-900">Étude de votre conduit</h2>
          <p class="mt-3 text-ink-600 leading-relaxed">
            Diagnostic du conduit existant (tubage, ramonage, hauteur, étanchéité). Si nécessaire, mise en conformité incluse au devis.
          </p>
        </div>
        <div class="p-8 bg-warm-50 rounded-2xl border border-warm-100">
          <p class="text-2xl font-bold text-brand-500">2</p>
          <h2 class="mt-2 text-xl font-bold text-ink-900">Choix de l'insert + habillage</h2>
          <p class="mt-3 text-ink-600 leading-relaxed">
            Insert bois ou granulés Godin, habillage en pierre, bois ou plâtre selon votre intérieur. Plans 3D fournis.
          </p>
        </div>
        <div class="p-8 bg-warm-50 rounded-2xl border border-warm-100">
          <p class="text-2xl font-bold text-brand-500">3</p>
          <h2 class="mt-2 text-xl font-bold text-ink-900">Installation et finitions</h2>
          <p class="mt-3 text-ink-600 leading-relaxed">
            Pose en 2 à 5 jours selon complexité, finitions soignées, mise en service et formation à l'utilisation.
          </p>
        </div>
      </div>

      <div class="max-w-3xl mb-10">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Poêle ou insert ?
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
          Comment trancher <span class="text-brand-500">en 30 secondes</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
        {decisionPoeleInsert.map((bloc) => (
          <article class="p-6 sm:p-8 rounded-2xl bg-warm-50 border border-warm-100">
            <h3 class="text-xl font-bold text-ink-900 mb-5">{bloc.titre}</h3>
            <ul class="space-y-3">
              {bloc.items.map((item) => (
                <li class="flex items-start gap-3 text-ink-700 text-sm">
                  <svg class="flex-shrink-0 w-5 h-5 mt-0.5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <h2 class="text-3xl font-bold tracking-tight text-ink-900 mb-8">
        Quelques réalisations
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {realisations.map((r) => (
          <figure class="overflow-hidden rounded-xl bg-white border border-warm-100">
            <img
              src={r.image}
              alt={r.desc}
              width="600"
              height="450"
              loading="lazy"
              class="w-full aspect-[4/3] object-cover"
            />
            <figcaption class="p-3 text-sm text-ink-600">{r.desc}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <Faq
    eyebrow="Questions fréquentes — Inserts"
    heading="Tout ce qu'on nous demande avant de poser un insert"
    questions={faqInserts}
    variant="warm"
  />

  <CTA
    heading="Un projet de cheminée ou d'insert ?"
    description="Nos artisans étudient votre conduit et conçoivent l'installation adaptée. Visite technique gratuite, devis sous 48 h."
  />
</BaseLayout>
