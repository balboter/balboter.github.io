---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";

const points = [
  {
    titre: "Insert dans une cheminée existante",
    desc: "Vous avez un foyer ouvert peu performant ? Un insert fermé fait grimper le rendement de 10-15 % à 75-90 % et sécurise le conduit. C'est l'une des rénovations les plus rentables.",
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21h18M5 21V7l7-4 7 4v14M9 9h6M9 13h6M9 17h6"/></svg>',
  },
  {
    titre: "Cheminée avec foyer fermé",
    desc: "Pour une construction neuve ou une pièce sans conduit, nous installons un foyer fermé avec l'habillage adapté à votre intérieur. Conception, pose et finitions par nos équipes.",
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6"/></svg>',
  },
];
---

<BaseLayout
  title="Cheminées & inserts — Poêles Godin Évreux"
  description="Au-delà des poêles, nous installons aussi cheminées et inserts dans l'Eure et en Normandie. Visite technique gratuite et devis sous 48 h."
>
  <section class="bg-gradient-to-br from-ink-900 via-ink-800 to-ink-900 text-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Aussi chez Godin Évreux
      </p>
      <h1 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">
        Cheminées &amp; inserts
      </h1>
      <p class="mt-4 text-base sm:text-lg text-ink-300 max-w-3xl leading-relaxed">
        Notre cœur de métier, c'est le poêle. Mais nos équipes installent aussi
        cheminées et inserts pour les projets qui le demandent — rénovation d'un
        foyer ancien, construction neuve.
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-16 bg-white">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
        {points.map((p) => (
          <article class="p-6 sm:p-7 rounded-2xl bg-steel-50 border border-steel-100">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-brand-500 text-white">
              <span set:html={p.icon} />
            </div>
            <h2 class="mt-4 text-xl font-bold text-ink-900">{p.titre}</h2>
            <p class="mt-2 text-sm text-ink-600 leading-relaxed">{p.desc}</p>
          </article>
        ))}
      </div>

      <div class="mt-10 flex flex-col sm:flex-row gap-5 items-center p-6 sm:p-7 rounded-2xl bg-warm-50 border border-warm-100">
        <img
          src="/images/installations/126.webp"
          alt="Réalisation d'insert posé par les équipes Godin Évreux"
          width="240"
          height="180"
          loading="lazy"
          class="w-full sm:w-60 aspect-[4/3] object-cover rounded-xl"
        />
        <div>
          <h2 class="text-lg font-bold text-ink-900">Parlons-en au showroom</h2>
          <p class="mt-2 text-sm text-ink-600 leading-relaxed">
            Un projet de cheminée ou d'insert se discute mieux face aux modèles. Passez nous voir à Normanville, ou demandez une visite technique : nos conseillers étudient votre conduit et vous orientent.
          </p>
          <a
            href="/about"
            class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:text-brand-700 transition"
          >
            Découvrir notre showroom →
          </a>
        </div>
      </div>

      <p class="mt-8 text-sm text-ink-500">
        Vous cherchez plutôt un appareil indépendant et plus performant à l'usage ?{" "}
        <a href="/poeles-a-bois" class="text-brand-600 hover:text-brand-700 font-semibold underline-offset-4 hover:underline">
          Voir nos poêles à bois
        </a>{" "}ou{" "}
        <a href="/poeles-a-granules" class="text-brand-600 hover:text-brand-700 font-semibold underline-offset-4 hover:underline">
          nos poêles à granulés
        </a>.
      </p>
    </div>
  </section>

  <CTA
    heading="Un projet de cheminée ou d'insert ?"
    description="Nos équipes étudient votre conduit et conçoivent l'installation adaptée. Visite technique gratuite, devis sous 48 h."
  />
</BaseLayout>
