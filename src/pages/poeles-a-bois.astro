---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import PuissanceCalculator from "../components/PuissanceCalculator.astro";
import MiniComparateur from "../components/MiniComparateur.astro";
import BandeauAides from "../components/BandeauAides.astro";
import Faq from "../components/Faq.astro";

const realisations = [
  { src: "/images/installations/124.webp", lieu: "Pavillon · Eure" },
  { src: "/images/installations/155.webp", lieu: "Maison normande · Bernay" },
  { src: "/images/installations/169.webp", lieu: "Rénovation · Évreux" },
  { src: "/images/installations/200.webp", lieu: "Véranda · Le Neubourg" },
];

const modeles = [
  {
    nom: "Godin Le Petit Godin",
    puissance: "5 kW",
    surface: "30-50 m²",
    rendement: "78 %",
    style: "Traditionnel fonte",
    ideal: "Salon ou pièce à vivre compacte",
    image: "/images/installations/129.webp",
    desc: "Le poêle fonte iconique de la marque, compact et performant. Idéal en chauffage d'appoint ou pour petite pièce à vivre. Fabrication française, fonte massive.",
  },
  {
    nom: "Godin Carvin",
    puissance: "7 kW",
    surface: "50-80 m²",
    rendement: "80 %",
    style: "Classique",
    ideal: "Séjour de pavillon moyen",
    image: "/images/installations/123.webp",
    desc: "Polyvalent, design intemporel en fonte émaillée. Excellent rapport puissance/encombrement pour les pièces à vivre moyennes.",
  },
  {
    nom: "Godin Colombe",
    puissance: "8 kW",
    surface: "70-100 m²",
    rendement: "80 %",
    style: "Contemporain",
    ideal: "Intérieurs design, pièces ouvertes",
    image: "/images/installations/130.webp",
    desc: "Lignes modernes et vitre panoramique généreuse. La référence Godin pour les intérieurs design.",
    best: true,
  },
  {
    nom: "Godin Régate",
    puissance: "10 kW",
    surface: "90-140 m²",
    rendement: "78 %",
    style: "Traditionnel",
    ideal: "Chauffage principal pavillon, maison ancienne",
    image: "/images/installations/168.webp",
    desc: "Forte capacité de chauffe et autonomie longue. Recommandé en chauffage principal pour pavillon ou maison ancienne.",
  },
  {
    nom: "Godin Grand Carvin",
    puissance: "13 kW",
    surface: "130-180 m²",
    rendement: "78 %",
    style: "Traditionnel",
    ideal: "Très grands volumes, longère, pièces ouvertes",
    image: "/images/installations/145.webp",
    desc: "Très grandes surfaces ou pièces ouvertes, foyer profond pour bûches de 50 cm. Combustion longue durée.",
  },
  {
    nom: "Godin Théo",
    puissance: "8 kW",
    surface: "70-100 m²",
    rendement: "82 %",
    style: "Design",
    ideal: "Intérieurs minimalistes contemporains",
    image: "/images/installations/147.webp",
    desc: "Silhouette verticale épurée, foyer haut pour une belle vue sur les flammes. Pour intérieurs contemporains exigeants.",
  },
];

const trioComparateur = [
  {
    nom: "Godin Le Petit Godin",
    niveau: "Entrée de gamme",
    puissance: "5 kW",
    surface: "30-50 m²",
    rendement: "78 %",
    ideal: "Petite pièce ou chauffage d'appoint",
    image: "/images/installations/129.webp",
  },
  {
    nom: "Godin Colombe",
    niveau: "Milieu de gamme",
    puissance: "8 kW",
    surface: "70-100 m²",
    rendement: "80 %",
    ideal: "Séjour de pavillon, intérieur contemporain",
    image: "/images/installations/130.webp",
    best: true,
  },
  {
    nom: "Godin Grand Carvin",
    niveau: "Haut de gamme",
    puissance: "13 kW",
    surface: "130-180 m²",
    rendement: "78 %",
    ideal: "Grand pavillon, longère, pièce ouverte",
    image: "/images/installations/145.webp",
  },
];

const faqBois = [
  {
    q: "Combien de bois je vais brûler par hiver ?",
    a: "Comptez 3 à 6 stères de bois sec par hiver pour une maison de 100 m² bien isolée chauffée principalement au poêle, ou 1 à 2 stères pour un chauffage d'appoint. La qualité du bois (essence et humidité < 20 %) est déterminante pour le rendement et la propreté du conduit.",
  },
  {
    q: "Quelle est la durée de vie d'un poêle Godin ?",
    a: "Un poêle Godin en fonte est conçu pour durer 20 à 30 ans avec un entretien régulier. Certains modèles installés dans les années 90 fonctionnent encore. La fonte ne s'use pas comme l'acier, c'est l'un des arguments historiques de Godin depuis 1840.",
  },
  {
    q: "Quel entretien annuel sur un poêle à bois ?",
    a: "Un ramonage obligatoire chaque saison (par un professionnel agréé, ~80-100 €), vidange des cendres régulière, vérification des joints de porte et de la vitre. Une révision technique tous les 2-3 ans est recommandée pour les pièces d'usure (joints, déflecteurs).",
  },
  {
    q: "Faut-il du bois sec impérativement ?",
    a: "Oui — bois sec (humidité < 20 %, soit 18-24 mois de séchage à l'abri) est indispensable. Du bois humide divise le rendement par 2, encrasse le conduit et fait perdre la garantie. Nous vous orientons vers des fournisseurs locaux de confiance lors de l'installation.",
  },
  {
    q: "Mon conduit de cheminée actuel est-il compatible ?",
    a: "Pas toujours. Nous réalisons un diagnostic du conduit lors de la visite technique : étanchéité, section, hauteur, tirage. Si nécessaire, un tubage inox est posé (compté dans le devis). Pour une maison ancienne, c'est très souvent indispensable et conditionne la sécurité de l'installation.",
  },
];
---

<BaseLayout
  title="Poêles à bois Godin — Évreux & Normandie"
  description="Découvrez notre gamme de poêles à bois Godin : 6 modèles fabriqués en France, de 5 à 13 kW. Installation par nos équipes, accompagnement MaPrimeRénov' 2026."
>
  <section class="bg-gradient-to-br from-ink-900 via-ink-800 to-ink-900 text-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Nos gammes
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight">
        Poêles à bois Godin
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-ink-300 max-w-3xl leading-relaxed">
        Fabriqués en France à Guise et Liévin, les poêles à bois Godin combinent
        fonte massive, rendement élevé et design fidèle à 180 ans de tradition. Nos
        équipes vous conseillent le modèle adapté à votre logement et à votre
        besoin de chauffe.
      </p>
      <dl class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 max-w-2xl">
        <div>
          <dt class="text-xs text-ink-400 uppercase tracking-wider">Coût d'usage</dt>
          <dd class="mt-1 text-2xl sm:text-3xl font-bold text-brand-400">5-7 ct/kWh</dd>
          <dd class="text-xs text-ink-500 mt-1">le combustible le moins cher</dd>
        </div>
        <div class="sm:pl-8 sm:border-l sm:border-white/15">
          <dt class="text-xs text-ink-400 uppercase tracking-wider">Fonte Godin</dt>
          <dd class="mt-1 text-2xl sm:text-3xl font-bold text-brand-400">20-30 ans</dd>
          <dd class="text-xs text-ink-500 mt-1">durée de vie d'un poêle fonte</dd>
        </div>
        <div class="sm:pl-8 sm:border-l sm:border-white/15">
          <dt class="text-xs text-ink-400 uppercase tracking-wider">Rendement</dt>
          <dd class="mt-1 text-2xl sm:text-3xl font-bold text-brand-400">jusqu'à 82&nbsp;%</dd>
          <dd class="text-xs text-ink-500 mt-1">label Flamme Verte</dd>
        </div>
      </dl>
      <p class="mt-8 text-sm text-ink-400">
        Vous hésitez entre bois et granulés ?{" "}
        <a href="/guide-choix" class="text-brand-400 hover:text-brand-300 underline-offset-4 hover:underline font-semibold">
          Voir le guide de choix →
        </a>
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Pourquoi le bois
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
          Le chauffage au feu le plus <span class="text-brand-500">économique</span>
        </h2>
      </div>
      <div class="mt-8 sm:mt-10 grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
        <article class="p-6 rounded-2xl bg-steel-50 border border-steel-100">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-brand-500 text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-bold text-ink-900">Le combustible le moins cher</h3>
          <p class="mt-2 text-sm text-ink-600 leading-relaxed">À 5-7 centimes le kWh, la bûche reste imbattable face au gaz, au fioul et à l'électricité — surtout avec du bois local et bien sec.</p>
        </article>
        <article class="p-6 rounded-2xl bg-steel-50 border border-steel-100">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-brand-500 text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.24 17 6.343 18.485 8.343 17.85 12 16 14a4 4 0 11-6 0c1.5-1.5 1.5-3.5 1.5-3.5"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-bold text-ink-900">La fonte qui dure</h3>
          <p class="mt-2 text-sm text-ink-600 leading-relaxed">Godin coule sa propre fonte en France depuis 1840. Un poêle fonte restitue la chaleur longtemps après l'extinction et tient 20 à 30 ans.</p>
        </article>
        <article class="p-6 rounded-2xl bg-steel-50 border border-steel-100">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-brand-500 text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L23 12l-5.714 2.143L15 21l-2.286-6.857L7 12l5.714-2.143L15 3z"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-bold text-ink-900">Le plaisir du vrai feu</h3>
          <p class="mt-2 text-sm text-ink-600 leading-relaxed">Charger une bûche, regarder la flambée prendre : le poêle à bois reste le seul appareil qui offre l'ambiance d'un vrai feu, sans concession sur la performance.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          La gamme bois Godin
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
          Six modèles fonte, de 5 à 13 kW
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {modeles.map((m) => (
          <article class="group rounded-2xl overflow-hidden bg-white border border-ink-100 hover:border-brand-300 hover:shadow-xl transition">
            <div class="aspect-[4/3] overflow-hidden bg-warm-50 relative">
              <img
                src={m.image}
                alt={`${m.nom} ${m.puissance}`}
                width="600"
                height="450"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
              />
              {m.best && (
                <span class="absolute top-3 left-3 inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-brand-500 text-white text-xs font-bold uppercase tracking-wider shadow-md">
                  ⭐ Bestseller
                </span>
              )}
            </div>
            <div class="p-6">
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-xl font-bold text-ink-900">{m.nom}</h3>
                <span class="px-2.5 py-1 text-xs font-semibold text-brand-500 bg-brand-50 rounded">
                  {m.puissance}
                </span>
              </div>
              <p class="mt-3 text-ink-600 leading-relaxed text-sm">{m.desc}</p>

              <div class="mt-4 pt-4 border-t border-warm-100">
                <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Idéal pour</p>
                <p class="mt-1 text-sm text-ink-700 font-medium">{m.ideal}</p>
              </div>

              <dl class="mt-4 pt-4 border-t border-warm-100 grid grid-cols-3 gap-2 text-xs">
                <div>
                  <dt class="text-ink-500">Surface</dt>
                  <dd class="font-semibold text-ink-900">{m.surface}</dd>
                </div>
                <div>
                  <dt class="text-ink-500 inline-flex items-center gap-0.5">Rendement <span class="text-brand-500" aria-hidden="true">⭐</span></dt>
                  <dd class="font-semibold text-brand-500">{m.rendement}</dd>
                </div>
                <div>
                  <dt class="text-ink-500">Style</dt>
                  <dd class="font-semibold text-ink-900">{m.style}</dd>
                </div>
              </dl>

              <a
                href={`/contact?modele=${encodeURIComponent(m.nom)}&type=poele-bois`}
                class="mt-5 inline-flex items-center text-sm font-semibold text-brand-500 hover:text-brand-600 transition"
              >
                Demander un devis sur ce modèle →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <MiniComparateur
    eyebrow="Aide à la décision"
    heading="Comparer entrée, milieu et haut de gamme"
    description="Trois modèles emblématiques de notre catalogue, choisis pour couvrir 90 % des configurations. Hésitez-vous entre les trois ? Notre visite technique tranche selon votre logement."
    modeles={trioComparateur}
  />

  <PuissanceCalculator />

  <BandeauAides heading="Jusqu'à 1 250 € d'aides sur votre poêle à bois" />

  <section class="py-16 sm:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          Nos réalisations
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
          Des poêles à bois Godin posés près de chez vous
        </h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {realisations.map((r) => (
          <a href="/galerie" class="group relative aspect-square overflow-hidden rounded-xl bg-warm-50 shadow-md hover:shadow-xl transition">
            <img
              src={r.src}
              alt={`Installation de poêle à bois Godin — ${r.lieu}`}
              width="500"
              height="500"
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            />
            <span class="absolute bottom-3 left-3 right-3 px-3 py-1.5 rounded-full bg-white/90 backdrop-blur text-xs font-medium text-ink-900 opacity-0 group-hover:opacity-100 transition">{r.lieu}</span>
          </a>
        ))}
      </div>
      <div class="mt-8">
        <a href="/galerie" class="inline-flex items-center gap-2 px-6 py-3 rounded-md bg-steel-50 text-ink-900 font-semibold border border-steel-200 hover:border-brand-400 hover:text-brand-500 transition">
          Voir toute la galerie
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Faq
    eyebrow="Questions fréquentes — Bois"
    heading="Ce que les gens nous demandent avant d'acheter un poêle à bois"
    questions={faqBois}
  />

  <CTA
    heading="Pas sûr du modèle qui vous convient ?"
    description="Notre équipe se déplace gratuitement chez vous pour analyser votre besoin et vous conseiller le poêle adapté."
    ctaLabel="Réserver une visite technique"
  />
</BaseLayout>
