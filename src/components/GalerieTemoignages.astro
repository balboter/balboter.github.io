---
const photos = [
  { src: "/images/installations/168.webp", lieu: "Pavillon · Évreux" },
  { src: "/images/installations/130.webp", lieu: "Pièce à vivre · Verneuil" },
  { src: "/images/installations/164.webp", lieu: "Maison normande · Bernay" },
  { src: "/images/installations/200.webp", lieu: "Véranda · Le Neubourg" },
];

const temoignage = {
  quote:
    "Conseil impeccable, installation soignée et SAV réactif. Nos enfants adorent l'ambiance du salon, et notre facture de chauffage a baissé de 40 %.",
  author: "Marc & Hélène D.",
  role: "Maison à Évreux",
  initiales: "MD",
};
---

<section class="relative py-20 sm:py-24 lg:py-32 bg-white overflow-hidden">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center justify-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Nos réalisations
        <span class="inline-block w-8 h-px bg-brand-500"></span>
      </p>
      <h2 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink-900 leading-tight">
        Plus de <span class="text-brand-500">500 installations</span> en Normandie
      </h2>
      <p class="mt-5 text-lg sm:text-xl text-ink-600 leading-relaxed">
        Chaque projet est unique. Voici un aperçu des dernières installations réalisées par nos équipes.
      </p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 mb-12 sm:mb-16">
      {photos.map((p) => (
        <a
          href="/galerie"
          class="group relative aspect-square overflow-hidden rounded-2xl bg-warm-50 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
        >
          <img
            src={p.src}
            alt={`Installation à ${p.lieu}`}
            width="500"
            height="500"
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-900/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition"></div>
          <span class="absolute bottom-3 left-3 right-3 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/90 backdrop-blur text-xs font-medium text-ink-900 opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-all">
            <svg class="w-3 h-3 text-brand-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 2C7 2 5 5 5 8c0 3 1 5 5 10 4-5 5-7 5-10 0-3-2-6-5-6zm0 8a2 2 0 110-4 2 2 0 010 4z"/>
            </svg>
            {p.lieu}
          </span>
        </a>
      ))}
    </div>

    <div class="text-center mb-12 sm:mb-16">
      <a
        href="/galerie"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-md bg-white text-ink-900 font-semibold border-2 border-ink-200 hover:border-brand-400 hover:text-brand-500 transition"
      >
        Voir toutes les réalisations
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
        </svg>
      </a>
    </div>

    <figure class="relative max-w-3xl mx-auto p-8 sm:p-10 bg-warm-50 rounded-2xl border border-warm-100">
      <svg class="absolute top-6 right-6 w-12 h-12 text-brand-200 opacity-80" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9.5 4C5.358 4 2 7.358 2 11.5v.5a1 1 0 001 1h3a1 1 0 001-1V11c0-1.105.895-2 2-2h.5a1 1 0 001-1V5a1 1 0 00-1-1h-.5zm11 0c-4.142 0-7.5 3.358-7.5 7.5v.5a1 1 0 001 1h3a1 1 0 001-1V11c0-1.105.895-2 2-2h.5a1 1 0 001-1V5a1 1 0 00-1-1h-.5z"/>
      </svg>

      <div class="relative flex gap-1 text-brand-500 mb-4" aria-label="5 étoiles">
        {Array.from({ length: 5 }).map(() => (
          <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M10 1l3 6 6 1-4.5 4.5L16 19l-6-3-6 3 1.5-6.5L1 8l6-1 3-6z"/>
          </svg>
        ))}
        <span class="ml-2 text-sm text-ink-600 font-medium">5/5 · sur 50+ avis vérifiés</span>
      </div>

      <blockquote class="relative text-lg sm:text-xl text-ink-800 leading-relaxed">
        « {temoignage.quote} »
      </blockquote>

      <figcaption class="relative mt-6 pt-6 border-t border-warm-200 flex items-center gap-3">
        <div class="flex-shrink-0 w-12 h-12 rounded-full bg-brand-500 text-white flex items-center justify-center font-bold shadow-md">
          {temoignage.initiales}
        </div>
        <div>
          <p class="font-semibold text-ink-900">{temoignage.author}</p>
          <p class="text-sm text-ink-500">{temoignage.role}</p>
        </div>
      </figcaption>
    </figure>

    <div class="mt-12 sm:mt-14 max-w-2xl mx-auto text-center">
      <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink-900 leading-tight">
        Votre installation sera la prochaine.
      </h3>
      <p class="mt-3 text-base sm:text-lg text-ink-600 leading-relaxed">
        Posé et garanti par notre propre équipe — SAV à vie, un seul interlocuteur. Recevez un devis chiffré sous 48 h.
      </p>
      <a
        href="/contact"
        class="group mt-6 inline-flex items-center justify-center gap-2 px-8 py-4 rounded-md bg-brand-500 text-white font-semibold hover:bg-brand-600 transition-all shadow-md hover:shadow-lg hover:shadow-brand-500/30"
      >
        Demander mon devis gratuit
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
        </svg>
      </a>
    </div>
  </div>
</section>
