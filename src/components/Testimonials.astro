---
interface Testimonial {
  quote: string;
  author: string;
  role: string;
  company: string;
}

interface Props {
  heading?: string;
  testimonials: Testimonial[];
}

const { heading = "Ils nous font confiance", testimonials } = Astro.props;
---

<section class="py-20 lg:py-24 bg-brand-50">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-brand-900 text-center">
      {heading}
    </h2>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.map((t) => (
        <figure class="p-6 bg-white rounded-lg shadow-sm">
          <blockquote class="text-brand-800 leading-relaxed">
            « {t.quote} »
          </blockquote>
          <figcaption class="mt-4 pt-4 border-t border-brand-100">
            <p class="font-semibold text-brand-900">{t.author}</p>
            <p class="text-sm text-brand-600">{t.role}, {t.company}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
