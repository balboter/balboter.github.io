---
const steps = [
  {
    num: "01",
    title: "Visite technique gratuite",
    description:
      "Nous nous déplaçons chez vous pour étudier votre logement, votre conduit, votre besoin de chauffe. Sans engagement, sans frais.",
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>',
  },
  {
    num: "02",
    title: "Devis personnalisé sous 48 h",
    description:
      "Vous recevez un devis détaillé : modèle, puissance, installation, fumisterie, accompagnement MaPrimeRénov' chiffré.",
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>',
  },
  {
    num: "03",
    title: "Installation par nos équipes",
    description:
      "Nos installateurs salariés posent, raccordent et allument votre poêle avec vous. Le même interlocuteur reste joignable pour le SAV, des années plus tard.",
    icon: '<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.24 17 6.343 18.485 8.343 17.85 12 16 14a4 4 0 11-6 0c1.5-1.5 1.5-3.5 1.5-3.5"/></svg>',
  },
];
---

<section class="relative py-16 sm:py-20 lg:py-24 bg-white overflow-hidden">
  <div class="absolute top-0 right-0 w-1/2 h-full opacity-[0.04] pointer-events-none" aria-hidden="true" style="background-image: radial-gradient(circle at 80% center, #f17b00 0%, transparent 60%);"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Notre méthode
      </p>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink-900 leading-tight">
        Un seul interlocuteur, <span class="text-brand-500">du premier appel jusqu'au SAV</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
        Pas d'intermédiaire, pas de sous-traitance. Nos équipes prennent en charge l'intégralité du projet — c'est ce qui fait la différence depuis 1986.
      </p>
    </div>

    <div class="mt-12 sm:mt-16 relative">
      <div class="hidden md:block absolute top-14 left-[16.66%] right-[16.66%] h-0.5 bg-gradient-to-r from-brand-200 via-brand-400 to-brand-200" aria-hidden="true"></div>

      <ol class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 relative">
        {
          steps.map((step, i) => (
            <li class="group relative">
              <div class="relative flex flex-col items-start p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-warm-50 to-white border border-warm-100 hover:border-brand-300 hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-300 h-full">
                <div class="relative flex items-center justify-center w-16 h-16 rounded-2xl bg-brand-500 text-white shadow-lg shadow-brand-500/30 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
                  <span set:html={step.icon} />
                  <span class="absolute -top-2 -right-2 bg-ink-900 text-white text-xs font-bold rounded-full w-7 h-7 flex items-center justify-center border-2 border-white">
                    {i + 1}
                  </span>
                </div>

                <h3 class="mt-5 text-xl font-bold text-ink-900 leading-tight">{step.title}</h3>
                <p class="mt-3 text-ink-600 leading-relaxed text-sm sm:text-base">{step.description}</p>

                {i < 2 && (
                  <span class="md:hidden absolute -bottom-3 left-1/2 -translate-x-1/2 w-px h-6 bg-brand-300" aria-hidden="true"></span>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
