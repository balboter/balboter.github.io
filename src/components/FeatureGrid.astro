---
interface Feature {
  title: string;
  description: string;
  icon?: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  features: Feature[];
}

const { eyebrow, heading, description, features } = Astro.props;
---

<section class="py-20 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      {eyebrow && (
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider">
          {eyebrow}
        </p>
      )}
      <h2 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-brand-900">
        {heading}
      </h2>
      {description && (
        <p class="mt-4 text-lg text-brand-700 leading-relaxed">
          {description}
        </p>
      )}
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <article class="p-6 rounded-lg border border-brand-100 hover:border-brand-300 transition">
          <h3 class="text-lg font-semibold text-brand-900">{feature.title}</h3>
          <p class="mt-2 text-brand-700 leading-relaxed">{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
