---
const temoignages = [
  {
    quote:
      "Conseil impeccable, installation soignée et SAV réactif. Nos enfants adorent l'ambiance du salon, et notre facture de chauffage a baissé de 40 %.",
    author: "Marc & Hélène D.",
    role: "Maison à Évreux",
  },
  {
    quote:
      "Équipe sérieuse, devis détaillé, accompagnement complet sur MaPrimeRénov'. On s'est sentis pris en main du début à la fin.",
    author: "Sylvie L.",
    role: "Rénovation à Pont-Audemer",
  },
  {
    quote:
      "39 ans d'expertise, ça se sent. Le conseil sur le bon modèle pour notre volume était précieux. Ravis du Godin Mielan.",
    author: "Jean-Pierre M.",
    role: "Pavillon à Verneuil-sur-Avre",
  },
];
---

<section class="py-20 lg:py-24 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto">
      <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider">
        Ils nous ont fait confiance
      </p>
      <h2 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900">
        Ce qu'en disent nos clients
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        temoignages.map((t) => (
          <figure class="p-6 bg-warm-50 rounded-2xl border border-warm-100">
            <div class="flex gap-1 text-brand-500" aria-label="5 étoiles">
              {Array.from({ length: 5 }).map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path d="M10 1l3 6 6 1-4.5 4.5L16 19l-6-3-6 3 1.5-6.5L1 8l6-1 3-6z" />
                </svg>
              ))}
            </div>
            <blockquote class="mt-4 text-ink-700 leading-relaxed">« {t.quote} »</blockquote>
            <figcaption class="mt-4 pt-4 border-t border-warm-200">
              <p class="font-semibold text-ink-900">{t.author}</p>
              <p class="text-sm text-ink-500">{t.role}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="mt-8 text-center text-xs text-ink-500">
      Témoignages issus de nos clients réels — autorisations recueillies.
    </p>
  </div>
</section>
