---
const profils = [
  {
    titre: "Une pièce à vivre à réchauffer",
    desc: "30 à 50 m², salon ou cuisine ouverte",
    reco: "Poêle à bois compact 5-7 kW",
    href: "/poeles-a-bois",
    icon: '<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>',
  },
  {
    titre: "Un pavillon à chauffer en principal",
    desc: "70 à 120 m², avec longue autonomie",
    reco: "Poêle à granulés 8-10 kW",
    href: "/poeles-a-granules",
    icon: '<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21h18M3 7l9-4 9 4M5 21V11a2 2 0 012-2h10a2 2 0 012 2v10"/></svg>',
  },
  {
    titre: "Un grand volume à chauffer",
    desc: "120 m² et plus, chauffage central",
    reco: "Granulés 10-12 kW ou grand bois 13 kW",
    href: "/poeles-a-granules",
    icon: '<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16M19 21h2M19 21h-7M5 21H3m2 0h7M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5"/></svg>',
  },
  {
    titre: "Une cuisine à chauffer et faire vivre",
    desc: "Cœur de maison, cuisson au bois souhaitée",
    reco: "Cuisinière à bois Godin",
    href: "/cuisinieres",
    icon: '<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21h18M5 21V7l7-4 7 4v14M9 9h6M9 13h6M9 17h6"/></svg>',
  },
];
---

<section class="relative py-16 sm:py-20 lg:py-24 bg-white overflow-hidden">
  <div class="absolute left-0 top-0 w-1/3 h-full opacity-[0.04] pointer-events-none" aria-hidden="true" style="background-image: radial-gradient(circle at left center, #f17b00 0%, transparent 60%);"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        Par où commencer ?
      </p>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink-900 leading-tight">
        Trouvez votre point de départ <span class="text-brand-500">en 5 secondes</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
        Choisissez la situation qui ressemble le plus à la vôtre — on vous emmène directement vers la gamme adaptée à votre logement.
      </p>
    </div>

    <div class="mt-10 sm:mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      {profils.map((p, i) => (
        <a
          href={p.href}
          class="group relative flex flex-col p-6 sm:p-7 rounded-2xl bg-gradient-to-br from-warm-50 to-white border border-warm-100 hover:border-brand-400 hover:shadow-xl hover:shadow-brand-500/10 transition-all duration-300 hover:-translate-y-1"
        >
          <div class="absolute top-4 right-4 inline-flex items-center justify-center w-7 h-7 rounded-full bg-ink-100 text-ink-500 group-hover:bg-brand-500 group-hover:text-white transition-all text-xs font-bold">
            {i + 1}
          </div>

          <div class="text-brand-500 group-hover:text-brand-600 group-hover:scale-110 transition-all duration-300">
            <span set:html={p.icon} />
          </div>

          <h3 class="mt-5 text-lg font-bold text-ink-900 leading-tight pr-8">
            {p.titre}
          </h3>
          <p class="mt-2 text-sm text-ink-600">{p.desc}</p>

          <div class="mt-4 pt-4 border-t border-warm-100">
            <p class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Notre reco</p>
            <p class="mt-1 text-sm font-semibold text-brand-500">{p.reco}</p>
          </div>

          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-500 group-hover:text-brand-600 transition">
            Voir la gamme
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
            </svg>
          </span>
        </a>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-ink-500">
      Aucune de ces situations ?{" "}
      <a href="/contact" class="text-brand-500 hover:text-brand-600 font-semibold underline-offset-4 hover:underline">
        Décrivez-nous votre projet
      </a>, on revient vers vous sous 48 h.
    </p>
  </div>
</section>
