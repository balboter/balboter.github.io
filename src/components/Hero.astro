---
const stats = [
  {
    value: "39 ans",
    label: "d'expertise locale",
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
  },
  {
    value: "500+",
    label: "installations réalisées",
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>',
  },
  {
    value: "48 h",
    label: "pour votre devis",
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
  },
];
---

<section class="relative isolate overflow-hidden bg-gradient-to-br from-ink-900 via-ink-800 to-ink-900">
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src="/images/installations/200.webp"
      alt=""
      class="w-full h-full object-cover opacity-25 lg:hidden"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink-900/85 via-ink-900/70 to-ink-900 lg:hidden"></div>
  </div>

  <div
    class="absolute inset-0 opacity-30"
    aria-hidden="true"
    style="background-image: radial-gradient(circle at 20% 50%, rgba(241,123,0,0.55) 0%, transparent 55%), radial-gradient(circle at 80% 80%, rgba(241,123,0,0.35) 0%, transparent 55%);"
  >
  </div>

  <div
    class="absolute inset-0 opacity-[0.06] mix-blend-overlay"
    aria-hidden="true"
    style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E&quot;);"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-500/15 border border-brand-500/40 mb-6 shadow-lg shadow-brand-500/10">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span>
          </span>
          <span class="text-sm font-medium text-brand-300">Revendeur officiel Godin depuis 1986</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.05]">
          Chauffez mieux, <br class="hidden sm:inline" />
          <span class="text-brand-400">dépensez moins.</span>
        </h1>

        <p class="mt-5 sm:mt-6 text-base sm:text-lg lg:text-xl text-ink-200 leading-relaxed max-w-2xl">
          Poêles à bois et à granulés Godin, posés et garantis par la même équipe. Jusqu'à 92 % de rendement, 48 h d'autonomie et 2 400 € d'aides — installation dans l'Eure et en Normandie.
        </p>

        <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a
            href="/contact"
            class="group inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-brand-500 text-white font-semibold hover:bg-brand-600 transition shadow-lg shadow-brand-500/40 hover:shadow-xl hover:shadow-brand-500/50 hover:-translate-y-0.5"
          >
            Demander un devis gratuit
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
            </svg>
          </a>
          <a
            href="#simulateur-puissance"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-md bg-white/5 text-white font-semibold hover:bg-white/15 transition border border-white/25 backdrop-blur-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
            Calculer ma puissance
          </a>
        </div>

        <p class="mt-5 text-sm text-ink-300">
          Vous préférez en parler de vive voix ?
          <a href="tel:+33232395900" class="inline-flex items-center gap-1.5 font-bold text-white hover:text-brand-400 transition whitespace-nowrap">
            <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            02 32 39 59 00
          </a>
        </p>

        <dl class="mt-10 sm:mt-12 grid grid-cols-3 gap-3 sm:gap-6 max-w-lg">
          {stats.map((stat) => (
            <div class="flex flex-col items-start p-3 sm:p-0 rounded-lg sm:rounded-none bg-white/5 sm:bg-transparent border border-white/10 sm:border-0">
              <div class="text-brand-400" aria-hidden="true" set:html={stat.icon} />
              <dt class="mt-1 sm:mt-2 text-xs text-ink-400 uppercase tracking-wider leading-tight">{stat.label}</dt>
              <dd class="mt-1 text-xl sm:text-2xl lg:text-3xl font-bold text-white">{stat.value}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-8 inline-flex items-center gap-3 text-sm text-ink-300">
          <div class="flex gap-0.5 text-brand-400" role="img" aria-label="Note 4,9 sur 5 étoiles">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M10 1l3 6 6 1-4.5 4.5L16 19l-6-3-6 3 1.5-6.5L1 8l6-1 3-6z"/>
              </svg>
            ))}
          </div>
          <span>
            <strong class="text-white">4,9/5</strong> sur 50+ avis clients vérifiés
          </span>
        </div>
      </div>

      <div class="hidden lg:block lg:col-span-5">
        <div class="relative aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl ring-1 ring-white/10">
          <img
            src="/images/installations/200.webp"
            alt="Poêle Godin installé dans un salon contemporain en Normandie"
            width="800"
            height="1000"
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-900/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ink-900/80 backdrop-blur text-xs text-white border border-white/10">
              <svg class="w-3 h-3 text-brand-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M10 2C7 2 5 5 5 8c0 3 1 5 5 10 4-5 5-7 5-10 0-3-2-6-5-6zm0 8a2 2 0 110-4 2 2 0 010 4z"/>
              </svg>
              Installation à Évreux · 2024
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
