---
interface Props {
  heading?: string;
}
const {
  heading = "Jusqu'à 2 400 € d'aides sur votre poêle",
} = Astro.props;
---

<section class="relative py-14 sm:py-16 bg-steel-900 text-white overflow-hidden">
  <div class="absolute inset-0 opacity-30" aria-hidden="true" style="background-image: radial-gradient(circle at 15% 50%, rgba(241,123,0,0.45) 0%, transparent 55%), radial-gradient(circle at 85% 60%, rgba(241,123,0,0.25) 0%, transparent 55%);"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-12">
      <div class="lg:flex-1">
        <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider flex items-center gap-2">
          <span class="inline-block w-8 h-px bg-brand-500"></span>
          MaPrimeRénov' 2026 + CEE
        </p>
        <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight leading-tight">
          {heading}
        </h2>
        <p class="mt-3 text-steel-200 leading-relaxed max-w-xl">
          Les aides 2026 sont réouvertes. Si vous nous confiez le chantier, nous montons le dossier administratif complet à votre place — vous touchez la prime, sans la paperasse.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row lg:flex-col gap-3 sm:gap-4 lg:w-72">
        <div class="flex-1 p-4 rounded-xl bg-white/5 border border-white/10">
          <p class="text-xs uppercase tracking-wider text-steel-300">MaPrimeRénov'</p>
          <p class="mt-1 text-2xl font-bold text-brand-400">jusqu'à 1 500 €</p>
        </div>
        <div class="flex-1 p-4 rounded-xl bg-white/5 border border-white/10">
          <p class="text-xs uppercase tracking-wider text-steel-300">CEE chauffage</p>
          <p class="mt-1 text-2xl font-bold text-brand-400">jusqu'à 800 €</p>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row gap-3">
      <a
        href="/#estimateur-aides"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md bg-brand-500 text-white font-semibold hover:bg-brand-600 transition shadow-md"
      >
        Estimer mes aides
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
        </svg>
      </a>
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md bg-white/5 text-white font-semibold hover:bg-white/15 transition border border-white/20"
      >
        Devis avec aides chiffrées
      </a>
    </div>
  </div>
</section>
