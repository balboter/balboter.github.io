---
const navLinks = [
  { href: "/poeles-a-bois", label: "Poêles à bois" },
  { href: "/poeles-a-granules", label: "Poêles à granulés" },
  { href: "/cheminees-inserts", label: "Cheminées & inserts" },
  { href: "/galerie", label: "Galerie" },
  { href: "/about", label: "Notre histoire" },
  { href: "/contact", label: "Contact" },
];
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-ink-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3 group">
        <img
          src="/images/branding/logo.png"
          alt="Poêles Godin Évreux"
          width="48"
          height="48"
          class="h-12 w-auto"
        />
        <div class="hidden sm:block leading-tight">
          <p class="text-lg font-bold text-ink-900">Poêles Godin</p>
          <p class="text-xs text-ink-500 uppercase tracking-wider">Évreux · depuis 1986</p>
        </div>
      </a>

      <nav aria-label="Navigation principale" class="hidden lg:block">
        <ul class="flex items-center gap-7">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm font-medium text-ink-700 hover:text-brand-500 transition"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="hidden md:flex items-center gap-3">
        <a
          href="tel:+33232395900"
          class="text-sm font-semibold text-ink-700 hover:text-brand-500 transition"
        >
          02 32 39 59 00
        </a>
        <a
          href="/contact"
          class="inline-flex items-center px-5 py-2.5 rounded-md bg-brand-500 text-white text-sm font-semibold hover:bg-brand-600 transition shadow-sm"
        >
          Demander un devis
        </a>
      </div>

      <button
        type="button"
        class="lg:hidden p-2 -mr-2"
        aria-label="Ouvrir le menu"
        id="mobile-menu-toggle"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <nav
      aria-label="Navigation mobile"
      id="mobile-menu"
      class="lg:hidden hidden pb-4"
    >
      <ul class="flex flex-col gap-1">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block py-2.5 px-2 text-base font-medium text-ink-700 hover:text-brand-500 hover:bg-warm-50 rounded"
            >
              {link.label}
            </a>
          </li>
        ))}
        <li class="mt-3 pt-3 border-t border-ink-100">
          <a
            href="tel:+33232395900"
            class="block py-2.5 px-2 text-base font-semibold text-ink-700"
          >
            02 32 39 59 00
          </a>
        </li>
        <li>
          <a
            href="/contact"
            class="block mt-2 py-3 px-4 rounded-md bg-brand-500 text-white text-center font-semibold"
          >
            Demander un devis
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>
