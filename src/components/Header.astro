---
const navLinks = [
  { href: "/poeles-a-bois", label: "Poêles à bois" },
  { href: "/poeles-a-granules", label: "Poêles à granulés" },
  { href: "/cuisinieres", label: "Cuisinières" },
  { href: "/galerie", label: "Galerie" },
  { href: "/guide-choix", label: "Guide de choix" },
  { href: "/about", label: "À propos" },
  { href: "/contact", label: "Contact" },
];
---

<header class="sticky top-0 z-40 bg-ink-950/95 backdrop-blur border-b border-ink-800">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative flex items-center justify-center md:justify-between gap-4">
      <a href="/" class="flex items-center gap-3 group" aria-label="Accueil — Godin Exclusif Évreux">
        <img
          src="/images/branding/godin-exclusif-sm.png"
          alt="Godin Exclusif"
          width="300"
          height="200"
          class="h-16 sm:h-20 w-auto"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hidden md:block leading-tight pl-3 border-l border-ink-700">
          <p class="text-base font-semibold text-white">Évreux</p>
          <p class="text-xs text-ink-400 uppercase tracking-wider">depuis 1986</p>
        </div>
      </a>

      <nav aria-label="Navigation principale" class="hidden lg:block">
        <ul class="flex items-center gap-6">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-base font-medium text-ink-200 hover:text-brand-400 transition"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="hidden md:flex items-center gap-4">
        <a
          href="tel:+33232395900"
          class="inline-flex items-center gap-2 text-lg font-bold text-white hover:text-brand-400 transition"
        >
          <svg class="w-5 h-5 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          02 32 39 59 00
        </a>
      </div>

      <button
        type="button"
        class="absolute right-0 top-1/2 -translate-y-1/2 md:static md:translate-y-0 lg:hidden flex items-center justify-center w-12 h-12 text-white rounded hover:bg-ink-800 transition"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-toggle"
      >
        <svg class="w-7 h-7" id="menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="w-7 h-7 hidden" id="menu-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav
      aria-label="Navigation mobile"
      id="mobile-menu"
      class="lg:hidden hidden pb-4"
    >
      <ul class="flex flex-col gap-1">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block py-3 px-2 text-lg font-medium text-ink-200 hover:text-brand-400 hover:bg-ink-800 rounded"
            >
              {link.label}
            </a>
          </li>
        ))}
        <li class="mt-3 pt-3 border-t border-ink-800">
          <a
            href="tel:+33232395900"
            class="block py-3 px-2 text-xl font-bold text-white"
          >
            📞 02 32 39 59 00
          </a>
        </li>
        <li>
          <a
            href="/contact"
            class="block mt-2 py-4 px-4 rounded-md bg-brand-500 text-white text-center text-lg font-semibold"
          >
            Demander un devis
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");
  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", isHidden ? "false" : "true");
    toggle.setAttribute("aria-label", isHidden ? "Ouvrir le menu" : "Fermer le menu");
    iconOpen?.classList.toggle("hidden", !isHidden);
    iconClose?.classList.toggle("hidden", isHidden);
  });
</script>
