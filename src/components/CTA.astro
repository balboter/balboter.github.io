---
interface Props {
  heading: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  heading,
  description,
  ctaLabel = "Demander un devis",
  ctaHref = "/contact",
} = Astro.props;
---

<section class="relative isolate py-16 sm:py-20 lg:py-24 overflow-hidden">
  <img
    src="/images/installations/137.webp"
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
    loading="lazy"
    aria-hidden="true"
  />
  <div class="absolute inset-0 bg-gradient-to-br from-ink-900/95 via-ink-900/85 to-ink-900/95"></div>
  <div class="absolute inset-0 opacity-40" aria-hidden="true" style="background-image: radial-gradient(circle at 80% 50%, rgba(241,123,0,0.4) 0%, transparent 55%), radial-gradient(circle at 20% 80%, rgba(241,123,0,0.25) 0%, transparent 55%);"></div>

  <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-500/15 border border-brand-500/40 mb-6 backdrop-blur">
      <svg class="w-3.5 h-3.5 text-brand-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M10 2C7 2 5 5 5 8c0 3 1 5 5 10 4-5 5-7 5-10 0-3-2-6-5-6zm0 8a2 2 0 110-4 2 2 0 010 4z"/>
      </svg>
      <span class="text-xs sm:text-sm font-medium text-brand-300">Normanville · Eure</span>
    </div>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight">
      {heading}
    </h2>
    {description && (
      <p class="mt-5 text-base sm:text-lg text-ink-200 leading-relaxed">
        {description}
      </p>
    )}

    <div class="mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
      <a
        href={ctaHref}
        class="group inline-flex items-center justify-center gap-2 px-8 py-4 rounded-md bg-brand-500 text-white font-semibold hover:bg-brand-600 transition-all shadow-lg shadow-brand-500/40 hover:shadow-xl hover:shadow-brand-500/50 hover:-translate-y-0.5"
      >
        {ctaLabel}
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 12h15"/>
        </svg>
      </a>
      <a
        href="tel:+33232395900"
        class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-md bg-white/5 text-white font-semibold hover:bg-white/15 transition border border-white/25 backdrop-blur-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        02 32 39 59 00
      </a>
    </div>
  </div>
</section>
