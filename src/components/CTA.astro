---
interface Props {
  heading: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  heading,
  description,
  ctaLabel = "Demander un devis",
  ctaHref = "/contact",
} = Astro.props;
---

<section class="py-20 lg:py-24 bg-gradient-to-br from-ink-900 to-ink-800 relative overflow-hidden">
  <div
    class="absolute inset-0 opacity-20"
    style="background-image: radial-gradient(circle at 80% 50%, rgba(241,123,0,0.5) 0%, transparent 50%);"
  >
  </div>
  <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
      {heading}
    </h2>
    {description && (
      <p class="mt-4 text-lg text-ink-300 leading-relaxed">
        {description}
      </p>
    )}
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={ctaHref}
        class="inline-flex items-center justify-center px-8 py-4 rounded-md bg-brand-500 text-white font-semibold hover:bg-brand-600 transition shadow-lg shadow-brand-500/30"
      >
        {ctaLabel}
      </a>
      <a
        href="tel:+33232395900"
        class="inline-flex items-center justify-center px-8 py-4 rounded-md bg-white/10 text-white font-semibold hover:bg-white/15 transition border border-white/20"
      >
        Nous appeler — 02 32 39 59 00
      </a>
    </div>
  </div>
</section>
