---
interface Modele {
  nom: string;
  niveau: string;
  puissance: string;
  surface: string;
  rendement: string;
  ideal: string;
  image: string;
  best?: boolean;
}

interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  modeles: Modele[];
  productType?: string;
}

const { eyebrow = "Comparer", heading, description, modeles, productType = "poele-bois" } = Astro.props;
---

<section class="relative py-16 sm:py-20 lg:py-24 bg-warm-50 overflow-hidden">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-10 sm:mb-12">
      <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        {eyebrow}
      </p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
        {heading}
      </h2>
      {description && (
        <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">{description}</p>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      {modeles.map((m) => (
        <article class={`group relative flex flex-col rounded-2xl bg-white overflow-hidden border-2 transition-all hover:-translate-y-1 hover:shadow-xl ${m.best ? "border-brand-400 shadow-lg shadow-brand-500/10" : "border-ink-100 hover:border-brand-300"}`}>
          {m.best && (
            <div class="absolute top-4 left-4 z-10 inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-brand-500 text-white text-xs font-bold uppercase tracking-wider shadow-md">
              ⭐ Bestseller
            </div>
          )}

          <div class="aspect-[4/3] overflow-hidden bg-warm-100">
            <img
              src={m.image}
              alt={m.nom}
              width="500"
              height="375"
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            />
          </div>

          <div class="p-5 flex flex-col flex-1">
            <p class="text-xs font-semibold text-brand-600 uppercase tracking-wider">{m.niveau}</p>
            <h3 class="mt-1 text-lg font-bold text-ink-900">{m.nom}</h3>

            <dl class="mt-4 space-y-2.5 text-sm flex-1">
              <div class="flex justify-between gap-3 pb-2 border-b border-warm-100">
                <dt class="text-ink-500">Puissance</dt>
                <dd class="font-semibold text-ink-900">{m.puissance}</dd>
              </div>
              <div class="flex justify-between gap-3 pb-2 border-b border-warm-100">
                <dt class="text-ink-500">Surface chauffée</dt>
                <dd class="font-semibold text-ink-900">{m.surface}</dd>
              </div>
              <div class="flex justify-between gap-3 pb-2 border-b border-warm-100">
                <dt class="text-ink-500 inline-flex items-center gap-1">
                  Rendement
                  <span class="text-brand-500 text-xs" aria-hidden="true">⭐</span>
                </dt>
                <dd class="font-semibold text-brand-700">{m.rendement}</dd>
              </div>
              <div class="pt-1">
                <dt class="text-xs uppercase tracking-wider text-ink-500 font-semibold">Idéal pour</dt>
                <dd class="mt-1 text-sm text-ink-700">{m.ideal}</dd>
              </div>
            </dl>

            <a
              href={`/contact?modele=${encodeURIComponent(m.nom)}&type=${productType}`}
              class="mt-5 inline-flex items-center justify-center text-sm font-semibold text-brand-600 hover:text-brand-700 transition"
            >
              Demander un devis sur ce modèle →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
