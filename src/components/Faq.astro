---
interface Question {
  q: string;
  a: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  questions: Question[];
  variant?: "light" | "warm";
}

const {
  eyebrow = "Questions fréquentes",
  heading = "On répond avant que vous ne décrochiez le téléphone",
  description,
  questions,
  variant = "light",
} = Astro.props;

const bgClass = variant === "warm" ? "bg-warm-50" : "bg-white";
---

<section class={`relative py-16 sm:py-20 lg:py-24 ${bgClass} overflow-hidden`}>
  <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
      <p class="text-sm font-semibold text-brand-500 uppercase tracking-wider flex items-center justify-center gap-2">
        <span class="inline-block w-8 h-px bg-brand-500"></span>
        {eyebrow}
        <span class="inline-block w-8 h-px bg-brand-500"></span>
      </p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-ink-900 leading-tight">
        {heading}
      </h2>
      {description && (
        <p class="mt-4 text-base sm:text-lg text-ink-600 leading-relaxed">
          {description}
        </p>
      )}
    </div>

    <div class="space-y-3">
      {
        questions.map((item, i) => (
          <details class="group bg-white rounded-xl border border-ink-100 hover:border-brand-300 transition-colors overflow-hidden">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 p-5 sm:p-6 font-semibold text-ink-900 hover:bg-warm-50/50 transition-colors">
              <span class="flex-1 text-left text-base sm:text-lg">{item.q}</span>
              <span class="flex-shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-full bg-warm-50 text-brand-500 group-open:bg-brand-500 group-open:text-white transition-all">
                <svg class="w-4 h-4 group-open:rotate-45 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                </svg>
              </span>
            </summary>
            <div class="px-5 sm:px-6 pb-5 sm:pb-6 text-ink-600 leading-relaxed text-sm sm:text-base">
              {item.a}
            </div>
          </details>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <p class="text-sm text-ink-500">
        Une autre question ?{" "}
        <a href="/contact" class="text-brand-500 hover:text-brand-600 font-semibold underline-offset-4 hover:underline">
          Demandez à nos équipes
        </a>{" "}
        ou appelez le{" "}
        <a href="tel:+33232395900" class="text-brand-500 hover:text-brand-600 font-semibold">02 32 39 59 00</a>
      </p>
    </div>
  </div>
</section>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: questions.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  })}
/>
